# API listener
PORT=5000

# MongoDB application database; keep its URI and embedded password private
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

# Supabase Auth project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key
ICTS_EMAIL=icts@example.edu

# Browser origin allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# TLS: leave unset in development (a self-signed localhost certificate is created in server/certs).
# In production set real certificate paths, or TLS_MODE=off only behind a proxy that terminates TLS.
# TLS_KEY_PATH=
# TLS_CERT_PATH=
# NODE_ENV=production
